# ─────────────────────────────────────────────────────────────────────────────
# KRISHX Backend — Environment Variables
# Copy this file to .env for local development.
# In production (Cloud Run / App Engine) set these in GCP Console or Secret Manager.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# MUST be changed in production. Use at least 32 random characters.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
KRISHX_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MINIMUM_32_CHARS

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite path (default: krishx.db next to app.py)
# DB_PATH=/data/krishx.db

# PostgreSQL Cloud SQL (uncomment and set for production)
# DATABASE_URL=postgresql://user:password@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── SMTP Email ────────────────────────────────────────────────────────────────
# Leave SMTP_USER empty to enable DEV_MODE (OTPs printed to console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
# ALLOWED_ORIGINS=https://your-app.com,https://www.your-app.com

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000
